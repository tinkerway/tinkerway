#!/usr/bin/env bash
#MISE description="Install tools and pin a macOS SDK when the linker needs it"
#MISE quiet=true
# First time, and again after a pull when tools change. Does not open the app.
# Then: MBX_DISABLE=1 cargo run -p tinkerway-tauri
set -euo pipefail

cd "${MISE_PROJECT_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"

min_mise="2026.9.2"

say() {
  printf '\n== %s ==\n' "$1"
}

if ! command -v mise >/dev/null 2>&1; then
  for candidate in "${HOME}/.local/bin/mise" /opt/homebrew/bin/mise /usr/local/bin/mise; do
    if [[ -x "$candidate" ]]; then
      PATH="$(dirname "$candidate"):${PATH}"
      export PATH
      break
    fi
  done
fi

if ! command -v mise >/dev/null 2>&1; then
  printf '%s\n' "mise is not installed. Install it from https://mise.jdx.dev and run mise setup again." >&2
  exit 1
fi

mise_version() {
  mise --version | awk '{print $1}'
}

# True when $1 is strictly older than $2 (versions sort like 2026.9.2).
version_lt() {
  local first
  first="$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n 1)"
  [[ "$first" == "$1" && "$1" != "$2" ]]
}

say "Trusting mise config"
mise trust

current="$(mise_version)"
if version_lt "$current" "$min_mise"; then
  say "Updating mise"
  printf '%s\n' "mise ${current} is older than ${min_mise} (needed for betterleaks and mr-boxington)."
  mise self-update -y
  current="$(mise_version)"
  if version_lt "$current" "$min_mise"; then
    printf '%s\n' "mise is still ${current}. Update it to ${min_mise} or newer, then run mise setup again." >&2
    exit 1
  fi
fi

say "Installing tools"
mise install

probe_err=""

probe_link() {
  local out err
  out="$(mktemp)"
  err="$(mktemp)"
  if printf 'int main(void){return 0;}\n' | cc -x c -o "$out" - >/dev/null 2>"$err"; then
    rm -f "$out" "$err"
    return 0
  fi
  probe_err="$(cat "$err")"
  rm -f "$out" "$err"
  return 1
}

collect_sdk() {
  local root="$1" sdk base tbd ver
  [[ -d "$root" ]] || return 0
  for sdk in "$root"/MacOSX*.sdk; do
    [[ -d "$sdk" ]] || continue
    base="$(basename "$sdk")"
    [[ "$base" == "MacOSX.sdk" ]] && continue
    tbd="${sdk}/usr/lib/libSystem.tbd"
    [[ -f "$tbd" ]] || continue
    if grep -q 'arm64e.x1' "$tbd"; then
      continue
    fi
    ver="${base#MacOSX}"
    ver="${ver%.sdk}"
    printf '%s\t%s\n' "$ver" "$sdk"
  done
}

ensure_macos_sdk() {
  local original list chosen ver sdk dev_dir
  [[ "$(uname -s)" == "Darwin" ]] || return 0

  say "Checking the macOS SDK"
  if probe_link; then
    return 0
  fi

  case "$probe_err" in
    *arm64e.x1* | *unknown\ architecture*) ;;
    *)
      printf '%s\n' "A small C program failed to link:" "$probe_err" >&2
      return 1
      ;;
  esac
  original="$probe_err"

  list="$(mktemp)"
  dev_dir="$(xcode-select -p 2>/dev/null || true)"
  if [[ -n "$dev_dir" ]]; then
    collect_sdk "${dev_dir}/SDKs" >>"$list" || true
    collect_sdk "${dev_dir}/Platforms/MacOSX.platform/Developer/SDKs" >>"$list" || true
  fi
  collect_sdk /Library/Developer/CommandLineTools/SDKs >>"$list" || true

  chosen=""
  while IFS="$(printf '\t')" read -r ver sdk; do
    [[ -n "${sdk:-}" ]] || continue
    if SDKROOT="$sdk" probe_link; then
      chosen="$sdk"
      break
    fi
  done <<EOF
$(sort -V -r -k1,1 "$list" | awk -F '\t' '!seen[$2]++')
EOF
  rm -f "$list"

  if [[ -z "$chosen" ]]; then
    printf '%s\n' "The active macOS SDK uses arm64e.x1, and no older SDK linked." "$original" >&2
    return 1
  fi

  export SDKROOT="$chosen"
  printf '%s\n' "Active macOS SDK uses arm64e.x1, which this linker cannot read. Using ${SDKROOT}."
}

# Cargo reads this for later builds. Only written when the active SDK cannot link.
sdk_config=".cargo/config.toml"
sdk_marker="Written by mise setup"

write_sdk_config() {
  mkdir -p .cargo
  cat >"$sdk_config" <<EOF
# ${sdk_marker}. Machine-local; gitignored.
[env]
SDKROOT = { value = "${SDKROOT}", force = true }
EOF
}

clear_sdk_config() {
  if [[ -f "$sdk_config" ]] && grep -q -e "Written by mise setup" -e "Written by bin/setup" "$sdk_config"; then
    rm -f "$sdk_config"
  fi
}

ensure_macos_sdk

if [[ -n "${SDKROOT:-}" ]]; then
  write_sdk_config
else
  clear_sdk_config
fi

say "Ready"
printf '%s\n' "Open the app with:"
printf '%s\n' "mise tauri"
