{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tinkerway Capture (Tauri)",
  "version": "0.1.0",
  "identifier": "ai.tinkerway.tauri",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tinkerway",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon-1024.png"]
  }
}
